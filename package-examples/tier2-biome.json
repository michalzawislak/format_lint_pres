{
  "name": "example-package-tier2",
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format --check .",
    "lint": "eslint src/**/*.ts --cache",
    "lint:fix": "eslint src/**/*.ts --fix --cache",
    "check": "npm run format && npm run lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,html,scss,json}": [
      "biome format --write"
    ],
    "*.ts": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0"
  }
}
